<?xml version="1.0" encoding="UTF-8"?>
<!--
  Optional Liquibase changelog for the base-less reference entity tables that Hibernate would otherwise
  create: process_definition (database configurator). Trigger records are owned by trigger-service. Opt-in via the
  "chenile-process-reference" context, for teams that want Liquibase to own these tables instead of
  Hibernate ddl-auto. Changesets no-op if the tables already exist.

  Note: process_table, subprocess_error and chenile_crontab are NOT defined here. They extend Chenile base
  entities (AbstractJpaStateEntity / BaseJpaEntity) whose base and STM columns are framework-owned and
  version-specific; leave them to Hibernate, or generate their DDL with `liquibase diff` against your own
  Chenile version so the columns match ddl-auto=validate exactly.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="chenile-process-definition" author="chenile-process" context="chenile-process-reference">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="process_definition"/></not>
        </preConditions>
        <createTable tableName="process_definition">
            <column name="process_type" type="VARCHAR(255)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="definition" type="CLOB"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>
</databaseChangeLog>
