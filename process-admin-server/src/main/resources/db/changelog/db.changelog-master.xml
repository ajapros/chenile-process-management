<?xml version="1.0" encoding="UTF-8"?>
<!--
  Master Liquibase changelog aggregating every Chenile Process Management schema module. OPT-IN: nothing
  runs this unless a host adds the Liquibase dependency and sets, for example:

    spring.liquibase.change-log=classpath:db/changelog/db.changelog-master.xml
    spring.liquibase.contexts=chenile-process-outbox,chenile-process-history

  Contexts select which tables to apply:
    chenile-process-outbox     -> chenile_process_outbox, chenile_process_receipt
    chenile-process-history    -> process_table indexes (removes the retired completion snapshot table)
    chenile-process-reference  -> process_definition

  Running with no contexts applies all three. Initial-table changesets no-op if their table already exists; upgrade changesets reconcile legacy data, so this is
  safe alongside Hibernate-created tables. The included files resolve on the classpath, so the owning module
  jars (chenile-outbox, process-service) must be on the runtime classpath — they are
  for process-admin-server. The JDBC worker queue (chenile_process_work_item, context chenile-process-jdbc)
  is NOT aggregated here: this stock host uses in-VM delivery. A host that uses the jdbc-process-starter should
  include that module's own db/changelog/chenile-process-work.changelog.xml. A library host may instead point
  change-log at a single module's changelog.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <include file="db/changelog/chenile-process-outbox.changelog.xml" relativeToChangelogFile="false"/>
    <include file="db/changelog/chenile-process-history.changelog.xml" relativeToChangelogFile="false"/>
    <include file="db/changelog/chenile-process-reference.changelog.xml" relativeToChangelogFile="false"/>
</databaseChangeLog>
