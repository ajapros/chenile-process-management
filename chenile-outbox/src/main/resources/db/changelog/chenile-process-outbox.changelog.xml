<?xml version="1.0" encoding="UTF-8"?>
<!--
  Optional Liquibase changelog for the transactional outbox (chenile_process_outbox) and consumer
  receipts (chenile_process_receipt). Opt-in via the "chenile-process-outbox" context. Equivalent to
  chenile-process-outbox-schema.sql. Changesets no-op if the tables already exist.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="chenile-process-outbox" author="chenile-process" context="chenile-process-outbox">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="chenile_process_outbox"/></not>
        </preConditions>
        <createTable tableName="chenile_process_outbox">
            <column name="id" type="VARCHAR(128)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="process_id" type="VARCHAR(128)"/>
            <column name="command_type" type="VARCHAR(128)"><constraints nullable="false"/></column>
            <column name="payload" type="CLOB"><constraints nullable="false"/></column>
            <column name="idempotency_key" type="VARCHAR(512)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="attempt" type="INTEGER" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="visible_after" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="locked_by" type="VARCHAR(200)"/>
            <column name="claim_token" type="VARCHAR(128)"/>
            <column name="tenant_id" type="VARCHAR(255)"/>
            <column name="locked_until" type="TIMESTAMP"/>
            <column name="started_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="finished_at" type="TIMESTAMP"/>
            <column name="error_message" type="VARCHAR(4000)"/>
        </createTable>
        <addUniqueConstraint tableName="chenile_process_outbox" columnNames="idempotency_key"
                             constraintName="uk_chenile_process_outbox_idempotency"/>
        <createIndex tableName="chenile_process_outbox" indexName="idx_chenile_process_outbox_backlog">
            <column name="status"/>
            <column name="visible_after"/>
            <column name="locked_until"/>
        </createIndex>
        <createIndex tableName="chenile_process_outbox" indexName="idx_chenile_outbox_tenant_type_created">
            <column name="tenant_id"/><column name="command_type"/><column name="created_at"/><column name="id"/>
        </createIndex>
        <createIndex tableName="chenile_process_outbox" indexName="idx_chenile_process_outbox_process">
            <column name="process_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="chenile-process-receipt" author="chenile-process" context="chenile-process-outbox">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="chenile_process_receipt"/></not>
        </preConditions>
        <createTable tableName="chenile_process_receipt">
            <column name="consumer" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="receipt_key" type="VARCHAR(512)"><constraints nullable="false"/></column>
            <column name="received_at" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <addPrimaryKey tableName="chenile_process_receipt" columnNames="consumer, receipt_key"
                       constraintName="pk_chenile_process_receipt"/>
    </changeSet>
</databaseChangeLog>
